<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels.Products"
    xmlns:models="using:PriceTrail.Models"
    xmlns:asyncImageLoader="using:AsyncImageLoader"
    xmlns:fluentIcons="using:FluentIcons.Avalonia"
    x:Class="PriceTrail.Views.Products.ProductsView"
    x:DataType="vm:ProductsViewModel">

    <Grid>

        <ScrollViewer>

            <StackPanel
                Spacing="10">

                <!-- HEADER -->

                <Grid ColumnDefinitions="*,Auto">

                    <TextBlock
                        Grid.Column="0"
                        Classes="page-title"
                        Text="Products" />

                    <Button
                        Classes="primary"
                        Grid.Column="1"
                        Command="{Binding OpenAddProductModalCommand}">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">

                            <fluentIcons:SymbolIcon
                                Symbol="Add"
                                FontSize="16" />

                            <TextBlock Text="Add Product" />

                        </StackPanel>

                    </Button>

                </Grid>

                <!-- PRODUCTS -->

                <ItemsControl ItemsSource="{Binding Products}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <WrapPanel Orientation="Horizontal" />

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="models:Product.Product">

                            <Button
                                Classes="transparent"
                                Padding="0"
                                BorderThickness="0"
                                Command="{Binding $parent[ItemsControl].DataContext.OpenProductCommand}"
                                CommandParameter="{Binding}">

                                <Border
                                    Classes="card"
                                    Width="450"
                                    Padding="15"
                                    Margin="0,0,10,10">

                                    <Grid
                                        ColumnDefinitions="100,*,Auto"
                                        ColumnSpacing="15">

                                        <!-- IMAGE -->

                                        <Border
                                            Grid.Column="0"
                                            Width="100"
                                            Height="100"
                                            Background="{StaticResource SurfaceRaisedBrush}"
                                            CornerRadius="8"
                                            ClipToBounds="True">

                                            <Panel>
                                                <TextBlock
                                                    Text="No Image"
                                                    FontSize="14"
                                                    Foreground="#888888"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding DisplayImageUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                                                <Image
                                                    asyncImageLoader:ImageLoader.Source="{Binding DisplayImageUrl}"
                                                    Stretch="Uniform"
                                                    RenderOptions.BitmapInterpolationMode="HighQuality" />

                                            </Panel>

                                        </Border>

                                        <!-- INFO -->

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="5"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="{Binding Name}"
                                                FontSize="16"
                                                FontWeight="Bold" />

                                            <TextBlock
                                                FontSize="14">

                                                <Run Text="{Binding LowestPrice, StringFormat={}{0:0.##}}" />

                                                <Run Text="{Binding LowestPriceCurrency}" />

                                            </TextBlock>

                                            <TextBlock
                                                FontSize="14">

                                                <Run Text="{Binding LowestPriceStore}" />

                                            </TextBlock>

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
