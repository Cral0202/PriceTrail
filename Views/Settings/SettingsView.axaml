<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels.Settings"
    xmlns:converters="using:PriceTrail.Converters"
    x:Class="PriceTrail.Views.Settings.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <converters:TimeSpanToDisplayConverter
            x:Key="TimeSpanConverter"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer>
            <StackPanel
                Spacing="20"
                MaxWidth="700"
                HorizontalAlignment="Left">

                <TextBlock
                    Classes="page-title"
                    Text="Settings" />

                <!-- General -->

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="card-title"
                            Text="General" />

                        <TextBlock
                            Classes="card-description"
                            Text="Configure general application settings." />

                        <CheckBox
                            Content="Minimize to tray on close"
                            IsChecked="{Binding Settings.MinimizeToTrayEnabled}" />
                    </StackPanel>
                </Border>

                <!-- Price Refresh -->

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="card-title"
                            Text="Price Refresh" />

                        <TextBlock
                            Classes="card-description"
                            Text="Keep your tracked product prices up to date automatically." />

                        <CheckBox
                            Content="Automatically refresh prices"
                            IsChecked="{Binding Settings.AutomaticPriceRefreshEnabled}" />

                        <StackPanel
                            Spacing="6"
                            IsEnabled="{Binding Settings.AutomaticPriceRefreshEnabled}">

                            <TextBlock Text="Refresh interval" />

                            <ComboBox
                                ItemsSource="{Binding RefreshIntervals}"
                                SelectedItem="{Binding Settings.PriceRefreshInterval}">

                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Text="{Binding Converter={StaticResource TimeSpanConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Notifications -->

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="card-title"
                            Text="Notifications" />

                        <TextBlock
                            Classes="card-description"
                            Text="Get alerts when prices change." />

                        <CheckBox
                            Content="Enable notifications"
                            IsChecked="{Binding Settings.NotificationsEnabled}" />

                        <CheckBox
                            Content="Notify me when prices drop"
                            IsChecked="{Binding Settings.PriceDropNotificationEnabled}"
                            IsEnabled="{Binding Settings.NotificationsEnabled}" />
                    </StackPanel>
                </Border>

                <!-- Updates -->

                <Border Classes="card">
                    <StackPanel Spacing="12">
                        <TextBlock
                            Classes="card-title"
                            Text="Updates" />

                        <TextBlock
                            Classes="card-description"
                            Text="Keep PriceTrail up to date with the latest improvements and fixes." />

                        <StackPanel
                            Spacing="10"
                            IsVisible="{Binding UpdateInfo.IsUpdateAvailable}">

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Update available" />

                            <TextBlock
                                Text="{Binding UpdateInfo.LatestVersion,
                                StringFormat=PriceTrail {0} is available.}" />

                            <Button
                                Classes="primary"
                                Command="{Binding OpenLatestReleaseCommand}"
                                Content="Download update" />
                        </StackPanel>
                        <TextBlock
                            IsVisible="{Binding !UpdateInfo.IsUpdateAvailable}"
                            Opacity="0.7"
                            Text="You're running the latest version." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Text="{Binding AppVersion, StringFormat=Version {0}}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.7"/>
    </Grid>
</UserControl>
