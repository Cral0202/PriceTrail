<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:PriceTrail.ViewModels"
xmlns:models="using:PriceTrail.Models"
x:Class="PriceTrail.Views.ProductsView"
x:DataType="vm:ProductsViewModel">

    <!-- STYLES -->

    <UserControl.Styles>
        <Style Selector="Button.product-button:pointerover /template/ ContentPresenter, Button.product-button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid>

        <ScrollViewer>

            <StackPanel
            Margin="20"
            Spacing="10">

                <!-- HEADER -->

                <Grid ColumnDefinitions="*,Auto">

                    <TextBlock
                    Grid.Column="0"
                    Text="Products"
                    FontSize="28"
                    FontWeight="Bold" />

                    <Button
                    Grid.Column="1"
                    Content="Add Product"
                    Command="{Binding OpenAddProductModalCommand}" />

                </Grid>

                <!-- PRODUCTS -->

                <ItemsControl ItemsSource="{Binding Products}">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <WrapPanel Orientation="Horizontal" />

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="models:Product">

                            <Button
                            Classes="product-button"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding $parent[UserControl].DataContext.OpenProductCommand}"
                            CommandParameter="{Binding}">

                                <Border
                                Width="450"
                                Margin="0,0,10,10"
                                Padding="15"
                                CornerRadius="10"
                                Background="#1D1B1B">

                                    <Grid
                                    ColumnDefinitions="100,*,Auto"
                                    ColumnSpacing="15">

                                        <!-- IMAGE -->

                                        <Border
                                        Grid.Column="0"
                                        Width="100"
                                        Height="100"
                                        Background="#2D2B2B"
                                        CornerRadius="8">

                                            <TextBlock
                                            Text="No Image"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />

                                        </Border>

                                        <!-- INFO -->

                                        <StackPanel
                                        Grid.Column="1"
                                        Spacing="5"
                                        VerticalAlignment="Center">

                                            <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="16"
                                            FontWeight="Bold" />

                                            <TextBlock
                                            FontSize="14">

                                                <Run Text="{Binding LowestPrice}" />

                                                <Run Text="{Binding LowestPriceCurrency}" />

                                            </TextBlock>

                                            <TextBlock
                                            FontSize="14">

                                                <Run Text="{Binding LowestPriceStore}" />

                                            </TextBlock>

                                        </StackPanel>

                                        <!-- ACTIONS -->

                                        <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Top">

                                            <Button
                                            Content="Delete"
                                            Command="{Binding $parent[UserControl].DataContext.DeleteProductCommand}"
                                            CommandParameter="{Binding}" />

                                        </StackPanel>

                                    </Grid>

                                </Border>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- MODAL -->

        <Border
        IsVisible="{Binding IsAddProductModalOpen}"
        Background="#80000000">

            <Border
            Width="300"
            Padding="20"
            CornerRadius="10"
            Background="#1D1B1B"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel Spacing="10">

                    <TextBlock
                    Text="Add Product"
                    FontSize="20"
                    FontWeight="Bold" />

                    <TextBox
                    Text="{Binding NewProductName}"
                    PlaceholderText="Product Name" />

                    <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

                        <Button
                        Content="Cancel"
                        Command="{Binding CloseAddProductModalCommand}" />

                        <Button
                        Content="Add"
                        Command="{Binding AddProductCommand}" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
