<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:PriceTrail.ViewModels"
xmlns:models="using:PriceTrail.Models"
x:Class="PriceTrail.Views.ProductsView"
x:DataType="vm:ProductsViewModel">

    <Grid>

        <ScrollViewer>

            <StackPanel
            Margin="20"
            Spacing="10">

                <!-- HEADER -->

                <Grid ColumnDefinitions="*,Auto">

                    <TextBlock
                    Grid.Column="0"
                    Text="Products"
                    FontSize="28" />

                    <Button
                    Grid.Column="1"
                    Content="Add Product"
                    Command="{Binding OpenAddProductModalCommand}" />

                </Grid>

                <!-- PRODUCTS -->

                <ItemsControl ItemsSource="{Binding Products}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="models:Product">

                            <Border Padding="5">

                                <StackPanel
                                Orientation="Horizontal"
                                Spacing="10">

                                    <Button
                                    Content="{Binding Name}"
                                    Command="{Binding $parent[UserControl].DataContext.OpenProductCommand}"
                                    CommandParameter="{Binding}" />

                                    <Button
                                    Content="Delete"
                                    Command="{Binding $parent[UserControl].DataContext.DeleteProductCommand}"
                                    CommandParameter="{Binding}" />

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- MODAL -->

        <Border
        IsVisible="{Binding IsAddProductModalOpen}"
        Background="#80000000">

            <Border
            Width="300"
            Padding="20"
            CornerRadius="10"
            Background="#1D1B1B"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel Spacing="10">

                    <TextBlock
                    Text="Add Product"
                    FontSize="20"
                    FontWeight="Bold" />

                    <TextBox
                    Text="{Binding NewProductName}"
                    PlaceholderText="Product Name" />

                    <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

                        <Button
                        Content="Cancel"
                        Command="{Binding CancelAddProductCommand}" />

                        <Button
                        Content="Add"
                        Command="{Binding AddProductCommand}" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
