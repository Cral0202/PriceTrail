<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels.Notifications"
    xmlns:conv="using:PriceTrail.Converters"
    x:Class="PriceTrail.Views.Notifications.NotificationsView"
    x:DataType="vm:NotificationsViewModel">

    <UserControl.Resources>
        <conv:LocalDateTimeConverter x:Key="LocalTimeConverter" />
    </UserControl.Resources>

    <Grid>

        <ScrollViewer>

            <StackPanel
                Spacing="20"
                MaxWidth="700"
                HorizontalAlignment="Left">

                <DockPanel LastChildFill="False">

                    <TextBlock
                        DockPanel.Dock="Left"
                        Classes="page-title"
                        Text="Notifications"
                        VerticalAlignment="Center" />

                    <Button
                        Classes="primary"
                        DockPanel.Dock="Right"
                        Content="Clear All"
                        Command="{Binding ClearNotificationsCommand}"
                        IsVisible="{Binding Notifications.Count}"
                        VerticalAlignment="Center" />

                </DockPanel>

                <!-- NOTIFICATIONS -->

                <ItemsControl
                    ItemsSource="{Binding Notifications}"
                    IsVisible="{Binding Notifications.Count}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Classes="card"
                                Width="450"
                                Padding="15"
                                Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="Bold"
                                        FontSize="16"/>

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Text="{Binding Message}"
                                        TextWrapping="Wrap"/>

                                    <TextBlock
                                        Margin="0,10,0,0"
                                        Text="{Binding Timestamp, Converter={StaticResource LocalTimeConverter}}"
                                        Opacity="0.6"
                                        FontSize="12"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <TextBlock
            Text="No notifications"
            Opacity="0.6"
            FontSize="16"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding !Notifications.Count}" />

    </Grid>

</UserControl>
