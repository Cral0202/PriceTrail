<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:PriceTrail.ViewModels"
xmlns:models="using:PriceTrail.Models"
xmlns:converters="using:PriceTrail.Converters"
x:Class="PriceTrail.Views.ProductDetailsView"
x:DataType="vm:ProductDetailsViewModel">

    <UserControl.Resources>

        <converters:LocalDateTimeConverter
        x:Key="LocalDateTimeConverter" />

    </UserControl.Resources>

    <StackPanel Margin="20" Spacing="10">

        <Button
        Content="Back"
        Command="{Binding GoBackCommand}" />

        <Button
        Content="Refresh Prices"
        Command="{Binding RefreshPricesCommand}"
        IsEnabled="{Binding !IsRefreshing}" />

        <TextBlock
        Text="{Binding Product.Name}"
        FontSize="28" />

        <TextBox
        PlaceholderText="Product URL"
        Text="{Binding Url}" />

        <Button
        Content="Add Product Page"
        Command="{Binding AddProductPageCommand}" />

        <ItemsControl ItemsSource="{Binding Product.ProductPages}">

            <ItemsControl.ItemTemplate>

                <DataTemplate x:DataType="models:ProductPage">

                    <Border Padding="10">

                        <StackPanel Spacing="5">

                            <TextBlock
                            Text="{Binding StoreName}"
                            FontWeight="Bold" />

                            <TextBlock
                            Text="{Binding Price}" />

                            <TextBlock
                            Text="{Binding Currency}" />

                            <Button
                            Content="Delete"
                            Command="{Binding $parent[UserControl].DataContext.DeleteProductPageCommand}"
                            CommandParameter="{Binding}" />

                            <TextBlock
                            Text="Price History"
                            FontWeight="Bold"
                            Margin="0,10,0,0" />

                            <ItemsControl ItemsSource="{Binding PriceHistory}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="models:PriceHistoryEntry">

                                        <Border Padding="5">

                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10">

                                                <TextBlock
                                                Text="{Binding Price}" />

                                                <TextBlock
                                                Text="{Binding Currency}" />

                                                <TextBlock
                                                Text="{Binding Timestamp,
                                                Converter={StaticResource LocalDateTimeConverter}}" />

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>

</UserControl>
