<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:vm="using:PriceTrail.ViewModels"
xmlns:models="using:PriceTrail.Models"
xmlns:converters="using:PriceTrail.Converters"
x:Class="PriceTrail.Views.ProductDetailsView"
x:DataType="vm:ProductDetailsViewModel">

    <UserControl.Resources>

        <converters:LocalDateTimeConverter
        x:Key="LocalDateTimeConverter" />

    </UserControl.Resources>

    <Grid>

        <ScrollViewer>

            <StackPanel Margin="20" Spacing="10">

                <!-- HEADER -->

                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,10">

                    <TextBlock
                    Grid.Column="0"
                    Text="{Binding Product.Name}"
                    FontSize="28"
                    FontWeight="Bold" />

                    <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="10">

                        <Button
                        Content="Back"
                        Command="{Binding GoBackCommand}" />

                        <Button
                        Content="Add URL"
                        Command="{Binding OpenAddProductPageModalCommand}" />

                        <Button
                        Content="Refresh Prices"
                        Command="{Binding RefreshPricesCommand}"
                        IsEnabled="{Binding !IsRefreshing}" />

                        <Button
                        Content="Edit"
                        Command="{Binding OpenEditProductModalCommand}" />

                    </StackPanel>

                </Grid>

                <!-- PRODUCT PAGES -->

                <ItemsControl ItemsSource="{Binding Product.ProductPages}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="models:ProductPage">

                            <Border Padding="10">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                    Text="{Binding StoreName}"
                                    FontWeight="Bold" />

                                    <TextBlock
                                    Text="{Binding Price}" />

                                    <TextBlock
                                    Text="{Binding Currency}" />

                                    <Button
                                    Content="Delete"
                                    Command="{Binding $parent[UserControl].DataContext.DeleteProductPageCommand}"
                                    CommandParameter="{Binding}" />

                                    <TextBlock
                                    Text="Price History"
                                    FontWeight="Bold"
                                    Margin="0,10,0,0" />

                                    <ItemsControl ItemsSource="{Binding PriceHistory}">

                                        <ItemsControl.ItemTemplate>

                                            <DataTemplate x:DataType="models:PriceHistoryEntry">

                                                <Border Padding="5">

                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="10">

                                                        <TextBlock
                                                        Text="{Binding Price}" />

                                                        <TextBlock
                                                        Text="{Binding Currency}" />

                                                        <TextBlock
                                                        Text="{Binding Timestamp,
                                                        Converter={StaticResource LocalDateTimeConverter}}" />

                                                    </StackPanel>

                                                </Border>

                                            </DataTemplate>

                                        </ItemsControl.ItemTemplate>

                                    </ItemsControl>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

        <!-- MODALS -->

        <Border
        IsVisible="{Binding IsAddProductPageModalOpen}"
        Background="#80000000">

            <Border
            Width="300"
            Padding="20"
            CornerRadius="10"
            Background="#1D1B1B"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel Spacing="10">

                    <TextBlock
                    Text="Add Product Page"
                    FontSize="20"
                    FontWeight="Bold" />

                    <TextBox
                    Text="{Binding NewProductPageUrl}"
                    PlaceholderText="URL" />

                    <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

                        <Button
                        Content="Cancel"
                        Command="{Binding CloseAddProductPageModalCommand}" />

                        <Button
                        Content="Add"
                        Command="{Binding AddProductPageCommand}" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>

        <Border
        IsVisible="{Binding IsEditProductModalOpen}"
        Background="#80000000">

            <Border
            Width="300"
            Padding="20"
            CornerRadius="10"
            Background="#1D1B1B"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

                <StackPanel Spacing="10">

                    <TextBlock
                    Text="Edit Product"
                    FontSize="20"
                    FontWeight="Bold" />

                    <StackPanel Spacing="4">

                        <TextBlock
                        Text="Name"
                        Opacity="0.7" />

                        <TextBox
                        Text="{Binding NewProductName}"
                        PlaceholderText="Name" />

                    </StackPanel>

                    <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10">

                        <Button
                        Content="Close"
                        Command="{Binding CloseEditProductModalCommand}" />

                    </StackPanel>

                </StackPanel>

            </Border>

        </Border>

    </Grid>

</UserControl>
