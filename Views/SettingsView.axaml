<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels"
    x:Class="PriceTrail.Views.SettingsView"
    x:DataType="vm:SettingsViewModel">

    <Grid>

        <ScrollViewer>

            <StackPanel
                Margin="20"
                Spacing="10">

                <TextBlock
                    Text="Settings"
                    FontSize="28"
                    FontWeight="Bold" />

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
