<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:PriceTrail.Views"
        xmlns:productsViews="using:PriceTrail.Views.Products"
        xmlns:productsVms="using:PriceTrail.ViewModels.Products"
        xmlns:productDetailViews="using:PriceTrail.Views.ProductDetails"
        xmlns:productDetailVms="using:PriceTrail.ViewModels.ProductDetails"
        xmlns:vm="using:PriceTrail.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:fluentIcons="using:FluentIcons.Avalonia"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PriceTrail.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Logo/logo.ico"
        Title="PriceTrail"
        Width="1200"
        Height="800"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.DataTemplates>

        <DataTemplate DataType="productsVms:ProductsViewModel">
            <productsViews:ProductsView />
        </DataTemplate>

        <DataTemplate DataType="productDetailVms:ProductDetailsViewModel">
            <productDetailViews:ProductDetailsView />
        </DataTemplate>

    </Window.DataTemplates>

    <Grid>

        <Grid ColumnDefinitions="64,*">
            <Grid.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="!IsLoading" />
                    <Binding Path="!HasError" />
                </MultiBinding>
            </Grid.IsVisible>

            <!-- Sidebar -->
            <Border
                Grid.Column="0">

                <StackPanel
                    Margin="0,12"
                    Spacing="8"
                    HorizontalAlignment="Center">

                    <Button
                        Classes="sidebar"
                        Classes.active="{Binding IsProductsActive}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        CornerRadius="8"
                        ToolTip.Tip="Products"
                        Command="{Binding ShowProductsCommand}">

                        <fluentIcons:SymbolIcon
                            Symbol="Box"
                            FontSize="24" />

                    </Button>

                    <Button
                        Classes="sidebar"
                        Classes.active="{Binding IsSettingsActive}"
                        Width="48"
                        Height="48"
                        Padding="0"
                        CornerRadius="8"
                        ToolTip.Tip="Settings"
                        Command="{Binding ShowSettingsCommand}">

                        <fluentIcons:SymbolIcon
                            Symbol="Settings"
                            FontSize="24" />

                    </Button>

                </StackPanel>

            </Border>

            <!-- Current page -->
            <Border
                Grid.Column="1"
                Padding="20">

                <ContentControl
                    Content="{Binding CurrentViewModel}" />

            </Border>

            <!-- Modal -->

            <Border
                Grid.ColumnSpan="2"
                ZIndex="10"
                IsVisible="{Binding IsModalOpen}"
                Background="{StaticResource ModalOverlayBrush}">

                <ContentControl
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="{Binding CurrentModalViewModel}" />

            </Border>

        </Grid>

        <StackPanel
            IsVisible="{Binding IsLoading}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">

            <ProgressBar
                IsIndeterminate="True"
                Width="250"
                Height="4"
                CornerRadius="2" />

            <TextBlock
                Text="Initializing..."
                HorizontalAlignment="Center"
                FontSize="14"
                Foreground="Gray"/>
        </StackPanel>

        <StackPanel
            IsVisible="{Binding HasError}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">

            <fluentIcons:SymbolIcon
                Symbol="ErrorCircle"
                FontSize="48"
                Foreground="Red"
                HorizontalAlignment="Center"/>

            <TextBlock
                Text="Startup Error"
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Foreground="Red"/>

            <TextBlock
                Text="{Binding ErrorMessage}"
                HorizontalAlignment="Center"
                TextAlignment="Center"
                FontSize="14"
                TextWrapping="Wrap"
                MaxWidth="500"/>
        </StackPanel>

    </Grid>

</Window>
