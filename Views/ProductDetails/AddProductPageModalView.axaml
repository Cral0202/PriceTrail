<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels.ProductDetails"
    x:Class="PriceTrail.Views.ProductDetails.AddProductPageModalView"
    x:DataType="vm:AddProductPageModalViewModel">

    <Border
        Classes="modal"
        Width="300">

        <StackPanel Spacing="10">

            <TextBlock
                Classes="modal-title"
                Text="Add Product Page" />

            <TextBox
                Text="{Binding Url}"
                PlaceholderText="URL" />

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">

                <Button
                    Classes="outline"
                    Content="Cancel"
                    Command="{Binding CloseCommand}" />

                <Button
                    Classes="primary"
                    Content="Add"
                    Command="{Binding AddProductPageCommand}" />

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
