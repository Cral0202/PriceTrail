<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PriceTrail.ViewModels.ProductDetails"
    xmlns:fluentIcons="using:FluentIcons.Avalonia"
    x:Class="PriceTrail.Views.ProductDetails.EditProductPageModalView"
    x:DataType="vm:EditProductPageModalViewModel">

    <Border
        Classes="modal"
        Width="300">

        <StackPanel Spacing="16">

            <TextBlock
                Classes="modal-title"
                Text="Edit Product Page"/>

            <StackPanel Spacing="4">

                <TextBlock
                    Text="Store Name"
                    Opacity="0.7" />

                <TextBox
                    Text="{Binding NewStoreName}"
                    PlaceholderText="Name" />

            </StackPanel>

            <!-- DANGER ZONE -->

            <StackPanel Spacing="10">

                <TextBlock
                    Text="Danger Zone"
                    FontWeight="SemiBold" />

                <Button
                    Classes="danger"
                    Command="{Binding DeleteProductPageCommand}">

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">

                        <fluentIcons:SymbolIcon
                            Symbol="Delete"
                            FontSize="16" />

                        <TextBlock Text="Delete" />

                    </StackPanel>

                </Button>

            </StackPanel>

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="10">

                <Button
                    Classes="outline"
                    Content="Close"
                    Command="{Binding CloseCommand}" />

            </StackPanel>

        </StackPanel>

    </Border>

</UserControl>
