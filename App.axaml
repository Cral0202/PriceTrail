<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PriceTrail.App"
             xmlns:local="using:PriceTrail"
             RequestedThemeVariant="Dark">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Brushes.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources
                    x:Key="Dark"
                    Accent="#B45309"
                    RegionColor="#23211F"
                    BaseHigh="#F3F3F3"
                    BaseMedium="#BDBDBD"
                    ChromeLow="#2B2927"
                    ChromeMedium="#34312F"
                    ChromeHigh="#474340"/>
            </FluentTheme.Palettes>
        </FluentTheme>

        <StyleInclude Source="/Styles/WindowStyles.axaml"/>
        <StyleInclude Source="/Styles/ModalStyles.axaml" />
        <StyleInclude Source="/Styles/ButtonStyles.axaml"/>
        <StyleInclude Source="/Styles/CheckBoxStyles.axaml"/>

    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon
                Icon="/Assets/avalonia-logo.ico"
                ToolTipText="PriceTrail">

                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem
                            Header="Show"
                            Click="TrayShowWindow_Click" />

                        <NativeMenuItem
                            Header="Exit"
                            Click="TrayExit_Click" />
                    </NativeMenu>
                </TrayIcon.Menu>

            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
