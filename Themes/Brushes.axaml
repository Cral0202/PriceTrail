<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush
        x:Key="WindowBackgroundBrush"
        Color="{StaticResource WindowBackgroundColor}"/>

    <SolidColorBrush
        x:Key="SurfaceBrush"
        Color="{StaticResource SurfaceColor}"/>

    <SolidColorBrush
        x:Key="SurfaceRaisedBrush"
        Color="{StaticResource SurfaceRaisedColor}"/>

    <!-- Borders -->
    <SolidColorBrush
        x:Key="BorderBrush"
        Color="{StaticResource BorderColor}"/>

    <!-- Text -->
    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        Color="{StaticResource PrimaryTextColor}"/>

    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        Color="{StaticResource SecondaryTextColor}"/>

    <!-- Accent -->
    <SolidColorBrush
        x:Key="AccentBrushLighter"
        Color="{StaticResource AccentLighterColor}"/>

    <SolidColorBrush
        x:Key="AccentBrush"
        Color="{StaticResource AccentColor}"/>

    <SolidColorBrush
        x:Key="AccentBrushDarker"
        Color="{StaticResource AccentDarkerColor}"/>

    <!-- Modals -->

    <SolidColorBrush
        x:Key="ModalOverlayBrush"
        Color="{StaticResource ModalOverlayColor}"/>

    <SolidColorBrush
        x:Key="ModalSurfaceBrush"
        Color="{StaticResource ModalSurfaceColor}" />

    <!-- Buttons -->

    <SolidColorBrush
        x:Key="ButtonForegroundBrush"
        Color="{StaticResource ButtonForegroundColor}"/>

    <LinearGradientBrush
        x:Key="PrimaryButtonBackgroundBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Offset="0"
            Color="{StaticResource AccentLighterColor}"/>

        <GradientStop
            Offset="1"
            Color="{StaticResource AccentColor}"/>

    </LinearGradientBrush>

    <LinearGradientBrush
        x:Key="PrimaryButtonHoverBrush"
        StartPoint="0,0"
        EndPoint="1,1">

        <GradientStop
            Offset="0"
            Color="{StaticResource PrimaryButtonHoverStartColor}"/>

        <GradientStop
            Offset="1"
            Color="{StaticResource PrimaryButtonHoverEndColor}"/>

    </LinearGradientBrush>

    <SolidColorBrush
        x:Key="DangerButtonBackgroundBrush"
        Color="{StaticResource DangerButtonBackgroundColor}"/>

    <SolidColorBrush
        x:Key="DangerButtonHoverBrush"
        Color="{StaticResource DangerButtonHoverColor}"/>

</ResourceDictionary>
