<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.card">
        <Setter
            Property="Background"
            Value="{DynamicResource SurfaceBrush}" />

        <Setter
            Property="Padding"
            Value="20"/>

        <Setter
            Property="CornerRadius"
            Value="10"/>
    </Style>

</Styles>
