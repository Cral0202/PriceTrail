<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="TextBlock.page-title">
        <Setter
            Property="FontSize"
            Value="28"/>

        <Setter
            Property="FontWeight"
            Value="Bold"/>
    </Style>

    <Style Selector="TextBlock.modal-title">
        <Setter
            Property="FontSize"
            Value="20"/>

        <Setter
            Property="FontWeight"
            Value="Bold"/>
    </Style>

</Styles>
