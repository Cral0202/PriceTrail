<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBrushDarker}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushDarker}" />
    </Style>

    <Style Selector="CheckBox:checked:pressed /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{DynamicResource AccentBrushLighter}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrushLighter}" />
    </Style>

</Styles>
